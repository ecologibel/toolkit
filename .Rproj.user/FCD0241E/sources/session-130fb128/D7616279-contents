<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tools</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #f7f7f5;
    color: #24292e;
    display: flex;
    justify-content: center;
    padding: 80px 24px;
  }

  main { width: 100%; max-width: 480px; }

  h1 {
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 32px;
  }

  ul { list-style: none; }

  li { margin-bottom: 8px; }

  a {
    display: block;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid #e1e4e8;
    border-radius: 8px;
    color: #24292e;
    text-decoration: none;
    font-size: 15px;
    transition: border-color 0.15s;
  }

  a:hover { border-color: #888; }

  a span {
    font-size: 13px;
    color: #6a737d;
    margin-left: 8px;
  }
</style>
</head>
<body>
<main>
  <h1>Tools</h1>
  <ul>
    <li><a href="r-codepad/">R codepad<span>— syntax-highlighted scratchpad</span></a></li>
  </ul>
</main>
</body>
</html>
